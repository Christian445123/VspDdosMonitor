<?xml version="1.0" encoding="UTF-8"?>
<!--
  Installer (MSI) für den VSRP DDoS Monitor (C#-Admin-Client).
  Gebaut mit WiX Toolset 5 über installer\build-installer.ps1 (Version wird dort übergeben).
  Die Einstellungen der Benutzer (%APPDATA%\VspDdosMonitor) bleiben bei Update und Deinstallation erhalten.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="VSRP DDoS Monitor"
           Manufacturer="ViennaStateRP"
           Version="$(var.ProductVersion)"
           UpgradeCode="698B2BBA-5092-426F-A029-968A92A97360"
           Language="1031"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="VSRP DDoS Monitor - Admin-Client" />

    <!-- Neuere Version ersetzt die alte automatisch (Update ohne vorheriges Deinstallieren) -->
    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version des VSRP DDoS Monitor ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPCOMMENTS" Value="Admin-Client für den VSRP DDoS Monitor (Erkennung und Vorfallsübersicht)" />

    <!-- Fenster: Willkommen -> Zielordner -> Zugangsdaten -> Installieren -> Fertig -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="VSRP DDoS Monitor jetzt starten" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApp" FileRef="AppExe" ExeCommand="" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <!-- Zugangsdaten, die bei der Installation abgefragt werden (auch per Befehlszeile: msiexec /i ... API_KEY=...;
         bei einem Update werden sie nicht erneut abgefragt) -->
    <Property Id="API_KEY" Secure="yes" Hidden="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
      <!-- Ablauf: Zielordner -> Zugangsdaten -> Installieren -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ConfigDlg" Order="5"
               Condition="(WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;) AND NOT WIX_UPGRADE_DETECTED" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="6"
               Condition="(WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;) AND WIX_UPGRADE_DETECTED" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ConfigDlg" Order="3" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />

      <Dialog Id="ConfigDlg" Width="370" Height="270" Title="Zugangsdaten - VSRP DDoS Monitor">
        <Control Id="Title" Type="Text" X="15" Y="8" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Zugangsdaten" />
        <Control Id="Desc" Type="Text" X="15" Y="30" Width="340" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="Bitte den API-Schlüssel eingeben. Den Schlüssel erstellt ein Administrator im Web-Dashboard unter „API-Zugang“." />
        <Control Id="KeyLabel" Type="Text" X="15" Y="88" Width="340" Height="12" Transparent="yes" NoPrefix="yes" Text="API-Schlüssel" />
        <Control Id="KeyEdit" Type="Edit" X="15" Y="102" Width="340" Height="15" Property="API_KEY" Password="yes" Text="{200}" />
        <Control Id="Hint" Type="Text" X="15" Y="128" Width="340" Height="24" Transparent="yes" NoPrefix="yes"
                 Text="Der Schlüssel ist Pflicht. Bei einem Update der Anwendung wird er nicht erneut abgefragt und lässt sich später in der Anwendung unter Einstellungen ändern." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" DisableCondition="NOT API_KEY" EnableCondition="API_KEY">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- Programmordner: C:\VSRP-DDoS-Monitor (Laufwerk C bzw. Systemlaufwerk), im Installer änderbar -->
    <Directory Id="INSTALLFOLDER" Name="VSRP-DDoS-Monitor" />
    <SetDirectory Id="INSTALLFOLDER" Value="[WindowsVolume]VSRP-DDoS-Monitor" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="VSRP DDoS Monitor" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="VSRP DDoS Monitor" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="SetupValues" />
    </Feature>

    <!-- Die Anwendung übernimmt diese Werte beim ersten Start in ihre (pro Benutzer verschlüsselten) Einstellungen
         und entfernt danach den API-Schlüssel aus der Registry (soweit sie das darf). -->
    <ComponentGroup Id="SetupValues">
      <Component Id="SetupRegistryComponent" Directory="INSTALLFOLDER" Guid="*" Bitness="always64" Condition="API_KEY">
        <RegistryKey Root="HKLM" Key="Software\ViennaStateRP\VspDdosMonitor\Setup">
          <RegistryValue Name="ApiKey" Type="string" Value="[API_KEY]" />
          <RegistryValue Name="Stamp" Type="string" Value="[Date] [Time]" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- Alle Programmdateien (Anwendung, .NET-Laufzeit, Bibliotheken) kommen in den Programmordner -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="publish\**">
        <Exclude Files="publish\VspDdosMonitor.exe" />
      </Files>
      <Component Id="AppExeComponent" Guid="*">
        <File Id="AppExe" Source="publish\VspDdosMonitor.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcutComponent" Directory="AppStartMenuFolder" Guid="*">
        <Shortcut Id="StartMenuShortcut" Name="VSRP DDoS Monitor" Description="VSRP DDoS Monitor starten"
                  Target="[INSTALLFOLDER]VspDdosMonitor.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="AppStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ViennaStateRP\VspDdosMonitor" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
        <Shortcut Id="DesktopShortcut" Name="VSRP DDoS Monitor" Description="VSRP DDoS Monitor starten"
                  Target="[INSTALLFOLDER]VspDdosMonitor.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ViennaStateRP\VspDdosMonitor" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
